{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ailive",
  "version": "1.4.0",
  "identifier": "com.ailive.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ailive - TikTok Live AI Avatar",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AILive Studio",
    "copyright": "Copyright 2026 AILive",
    "shortDescription": "AILive TikTok Stream AI 3D Avatar Host",
    "longDescription": "Live interactive 3D anime avatar with Gemini Live API and TikTok live integration",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
